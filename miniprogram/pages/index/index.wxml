<view class="page">
    <view class="hero">
        <image class="logo" src="/assets/logo.png" mode="aspectFit"></image>
        <text class="title">跑者拾穗</text>
        <text class="subtitle">跑过的每一公里，都是拾起的一束穗。</text>
    </view>

    <view class="card">
        <text class="section-title">配速换算</text>
        <view class="row">
            <text class="label">距离</text>
            <picker range="{{distanceLabels}}" value="{{distanceIndex}}" bindchange="onDistanceChange">
                <view class="picker">{{distanceLabels[distanceIndex]}} ▾</view>
            </picker>
        </view>
        <view class="row">
            <text class="label">完赛时间</text>
            <view class="hms">
                <input class="num-input" type="number" maxlength="2" value="{{hours}}" data-field="hours" bindinput="onInput" />
                <text class="sep">时</text>
                <input class="num-input" type="number" maxlength="2" value="{{minutes}}" data-field="minutes" bindinput="onInput" />
                <text class="sep">分</text>
                <input class="num-input" type="number" maxlength="2" value="{{seconds}}" data-field="seconds" bindinput="onInput" />
                <text class="sep">秒</text>
            </view>
        </view>

        <view class="result" wx:if="{{hasResult}}">
            <view class="cell">
                <text class="value">{{pace}}</text>
                <text class="unit">每公里配速</text>
            </view>
            <view class="cell">
                <text class="value">{{speed}}</text>
                <text class="unit">公里/时</text>
            </view>
            <view class="cell">
                <text class="value">{{lap}}</text>
                <text class="unit">400 米单圈（秒）</text>
            </view>
        </view>
        <text class="hint" wx:else>请填写完赛时间，分和秒不超过 59。</text>
    </view>

    <view class="card">
        <text class="section-title">更多工具</text>
        <text class="desc">跑力与训练区间、心率区间、比赛配速手环、有氧基础测试等完整工具在网页版，请用浏览器打开：</text>
        <view class="link-row">
            <text class="link">{{siteUrl}}</text>
            <button class="copy" size="mini" bindtap="copySite">复制链接</button>
        </view>
        <text class="desc small">在网页上点「微信登录」，用微信扫码即可登录。</text>
    </view>
</view>
