.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 48rpx 32rpx 64rpx;
}

.hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 36rpx;
}

.logo {
    width: 128rpx;
    height: 128rpx;
    border-radius: 50%;
}

.title {
    margin-top: 16rpx;
    font-size: 44rpx;
    font-weight: 700;
    letter-spacing: 6rpx;
}

.subtitle {
    margin-top: 8rpx;
    color: #8a7a63;
    font-size: 26rpx;
}

.card {
    box-sizing: border-box;
    margin-bottom: 24rpx;
    padding: 32rpx;
    border: 2rpx solid #ece2cf;
    border-radius: 24rpx;
    background: #ffffff;
}

.section-title {
    display: block;
    margin-bottom: 20rpx;
    font-size: 32rpx;
    font-weight: 600;
}

.row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16rpx 0;
    border-bottom: 2rpx solid #f3ecdf;
}

.label {
    color: #8a7a63;
    font-size: 28rpx;
}

.picker {
    color: #8e6320;
    font-size: 30rpx;
}

.hms {
    display: flex;
    align-items: center;
}

.num-input {
    width: 72rpx;
    height: 60rpx;
    border: 2rpx solid #ece2cf;
    border-radius: 12rpx;
    background: #fffdf8;
    font-size: 30rpx;
    text-align: center;
}

.sep {
    margin: 0 12rpx 0 8rpx;
    color: #8a7a63;
    font-size: 26rpx;
}

.result {
    display: flex;
    justify-content: space-between;
    margin-top: 28rpx;
}

.cell {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
}

.value {
    color: #8e6320;
    font-size: 44rpx;
    font-weight: 700;
}

.unit {
    margin-top: 6rpx;
    color: #8a7a63;
    font-size: 22rpx;
}

.hint,
.desc {
    display: block;
    margin-top: 20rpx;
    color: #8a7a63;
    font-size: 26rpx;
    line-height: 1.6;
}

.desc.small {
    font-size: 24rpx;
}

.link-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 16rpx;
}

.link {
    color: #8e6320;
    font-size: 28rpx;
}

.copy {
    margin: 0;
    background: #f4e7cc;
    color: #8e6320;
}
