<view class="page">
    <view class="brand">
        <image class="logo" src="/assets/logo.png" mode="aspectFit"></image>
        <text class="name">跑者拾穗</text>
    </view>

    <view class="card" wx:if="{{viewState === 'loading'}}">
        <view class="spinner"></view>
        <text class="desc">正在读取登录信息…</text>
    </view>

    <view class="card" wx:elif="{{viewState === 'ready' || viewState === 'submitting'}}">
        <text class="title">登录跑者拾穗网页版</text>
        <text class="desc">你正在电脑或其他设备的浏览器上登录 run.zhonghcc.com。如果不是你本人操作，请点「取消」。</text>
        <button class="primary" loading="{{viewState === 'submitting'}}" disabled="{{viewState === 'submitting'}}" bindtap="handleConfirm">确认登录</button>
        <button class="plain" disabled="{{viewState === 'submitting'}}" bindtap="handleCancel">取消</button>
    </view>

    <view class="card" wx:elif="{{viewState === 'done'}}">
        <text class="icon ok">✓</text>
        <text class="title">已登录</text>
        <text class="desc">回到浏览器即可继续使用。</text>
        <button class="plain" bindtap="goHome">去小程序首页</button>
    </view>

    <view class="card" wx:elif="{{viewState === 'cancelled'}}">
        <text class="title">已取消登录</text>
        <text class="desc">网页上的登录码已失效。</text>
        <button class="plain" bindtap="goHome">去小程序首页</button>
    </view>

    <view class="card" wx:elif="{{viewState === 'expired'}}">
        <text class="title">登录码已失效</text>
        <text class="desc">登录码 5 分钟内有效。请在网页上点击刷新后重新扫码。</text>
        <button class="plain" bindtap="goHome">去小程序首页</button>
    </view>

    <view class="card" wx:elif="{{viewState === 'invalid'}}">
        <text class="title">请从网页扫码进入</text>
        <text class="desc">在浏览器打开 run.zhonghcc.com，点「微信登录」，再用微信扫描页面上的小程序码。</text>
        <button class="plain" bindtap="goHome">去小程序首页</button>
    </view>

    <view class="card error" wx:else>
        <text class="title">出了点问题</text>
        <text class="desc">{{errorText}}</text>
        <button class="primary" bindtap="handleRetry">重试</button>
    </view>
</view>
