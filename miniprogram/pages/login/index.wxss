.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 80rpx 40rpx;
}

.brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 48rpx;
}

.logo {
    width: 140rpx;
    height: 140rpx;
    border-radius: 50%;
}

.name {
    margin-top: 20rpx;
    font-size: 36rpx;
    font-weight: 700;
    letter-spacing: 4rpx;
}

.card {
    display: flex;
    flex-direction: column;
    align-items: center;
    box-sizing: border-box;
    padding: 48rpx 36rpx;
    border: 2rpx solid #ece2cf;
    border-radius: 24rpx;
    background: #ffffff;
    text-align: center;
}

.card.error {
    border-color: #f1c9c3;
}

.title {
    font-size: 36rpx;
    font-weight: 600;
}

.desc {
    margin: 16rpx 0 36rpx;
    color: #8a7a63;
    font-size: 28rpx;
    line-height: 1.6;
}

.icon {
    font-size: 64rpx;
    line-height: 1;
    margin-bottom: 16rpx;
}

.icon.ok {
    color: #4f7a4a;
}

.primary {
    width: 100%;
    background: #b7832f;
    color: #ffffff;
    font-weight: 600;
}

.plain {
    width: 100%;
    margin-top: 20rpx;
    background: #ffffff;
    color: #8e6320;
    border: 2rpx solid #e2cfa6;
}

.spinner {
    width: 44rpx;
    height: 44rpx;
    margin-bottom: 20rpx;
    border: 6rpx solid #f4e7cc;
    border-top-color: #b7832f;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
}

@keyframes spin {
    to {
        transform: rotate(360deg);
    }
}
